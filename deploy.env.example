# Copy this file to deploy.env, fill it in, then run:  bash deploy.sh
# (deploy.env holds your secrets: never share it or upload it anywhere public.)

# Region for everything (Europe-West1 is close to the Middle East and fully supported)
REGION=europe-west1

# AI keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google sign-in (leave empty on the FIRST run; the script tells you how to get them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The site's Gmail account that sends the summaries (Gmail + App Password)
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Meetly

# Limits that protect your API budget
MAX_VIDEO_MINUTES=150
MAX_MEETINGS_PER_DAY=5
